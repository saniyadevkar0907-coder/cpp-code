#include<iostream>
using namespace std;
    int main(){
    int n;
    cout<<"Enter number to check prime or not  :"<<endl;
    cin>>n;
    bool isPrime=true;
    //Assuming number is prime
    for(int i=2;i<n-1;i++){
    //Checking condition for number 
        if(n%i==0){
            isPrime=false;
            break;
        }
    }
    if(isPrime==true){
        cout<<"Number is prime";
    }
    else{
        cout<<"Number is not Prime";
        }
    return 0;
}
