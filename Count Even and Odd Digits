#include <iostream>
using namespace std;

int main()
{
    int n;

    // Ask the user to enter a number
    cout << "Enter a number: ";
    cin >> n;

    // Repeat until all digits are processed
    while(n > 0)
    {
        // Get the last digit of the number
        int digit = n % 10;

        // Check whether the digit is even
        if(digit % 2 == 0)
        {
            cout << digit << " is Even" << endl;
        }
        else
        {
            // If the digit is not even, it is odd
            cout << digit << " is Odd" << endl;
        }

        // Remove the last digit from the number
        n = n / 10;
    }

    return 0; 
}
