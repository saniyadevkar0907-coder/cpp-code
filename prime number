#include <iostream>
using namespace std;

int main()
{
    int n;
    int count = 0;  // Variable to count the number of factors

    // Ask the user to enter a number
    cout << "Enter a number: ";
    cin >> n;

    // Check all numbers from 1 to n
    for(int i = 1; i <= n; i++)
    {
        // If n is exactly divisible by i, then i is a factor
        if(n % i == 0)
        {
            count++;  // Increase the factor count
        }
    }

    // A prime number has exactly 2 factors: 1 and itself
    if(count == 2)
    {
        cout << "Prime number";
    }
    else
    {
        cout << "Not a prime number";
    }

    return 0;  // End of program
}
