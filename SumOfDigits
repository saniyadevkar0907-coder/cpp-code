#include <iostream>
using namespace std;

int main()
{
    int n, sum = 0;  // n stores the number and sum stores the sum of digits

    // Ask the user to enter a number
    cout << "Enter a number: ";
    cin >> n;

    // Repeat until all digits are processed
    while(n > 0)
    {
        int digit = n % 10;  // Get the last digit of the number

        sum = sum + digit;  // Add the digit to sum

        n = n / 10;  // Remove the last digit from the number
    }

    // Display the sum of all digits
    cout << "Sum of digits = " << sum;

    return 0; 
}
