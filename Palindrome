#include <iostream>
using namespace std;

int main()
{
    int n;
    int reverse = 0;

    // Ask the user to enter a number
    cout << "Enter a number: ";
    cin >> n;

    int temp = n;  // Store the original number for comparison

    // Reverse the number
    while(n > 0)
    {
        int digit = n % 10;  // Get the last digit of the number

        reverse = reverse * 10 + digit;  // Add digit to the reversed number

        n = n / 10;  // Remove the last digit from the number
    }

    // Compare the original number with the reversed number
    if(temp == reverse)
    {
        cout << "Entered number is palindrome ..." << endl;
    }
    else
    {
        cout << "Entered Number is Not palindrome ..." << endl;
    }

    return 0;
}
